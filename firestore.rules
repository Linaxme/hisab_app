rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get current user's document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Check if user belongs to a specific shop
    function belongsToShop(shopId) {
      return isAuthenticated() && getUserData().shopId == shopId;
    }
    
    // Check if user is owner of the shop
    function isShopOwner(shopId) {
      return belongsToShop(shopId) && getUserData().role == 'owner';
    }
    
    // Check if user is active (not disabled by owner)
    function isActiveUser() {
      return getUserData().active == true;
    }
    
    // Check if user can access shop data (belongs to shop + is active)
    function canAccessShop(shopId) {
      return belongsToShop(shopId) && isActiveUser();
    }
    
    // Check if user is owner and active
    function isActiveOwner(shopId) {
      return isShopOwner(shopId) && isActiveUser();
    }
    
    // Check if the current user is the ownerUid recorded on the shop document
    function isShopCreator(shopId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid;
    }
    
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    
    // App admin who approves premium payments
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.uid in ['NzYKmwMzBHg6k5YU6owjTDbnXVd2'];
    }
    
    // ============================================
    // PREMIUM (paid add-ons; only the app admin grants them)
    // ============================================
    match /shopPremium/{shopId} {
      allow read: if belongsToShop(shopId) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }
    
    match /premiumRequests/{requestId} {
      allow read: if isSuperAdmin() ||
        (isAuthenticated() && resource.data.uid == request.auth.uid);
      
      // An owner submits a bKash payment for their own shop; it starts as pending
      allow create: if isActiveOwner(request.resource.data.shopId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.addon == 'stock' &&
        request.resource.data.months in [1, 12] &&
        request.resource.data.amount is number &&
        request.resource.data.trxId is string &&
        request.resource.data.trxId.size() >= 6 &&
        request.resource.data.trxId.size() <= 30 &&
        request.resource.data.keys().hasOnly(['shopId', 'shopName', 'uid', 'userName', 'email',
          'addon', 'months', 'amount', 'trxId', 'senderNumber', 'status', 'createdAt']);
      
      allow update: if isSuperAdmin();
      allow delete: if false;
    }
    
    match /appConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Users can read their own document
      // Owners can read/list users of their own shop only (for staff list)
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (getUserData().role == 'owner' && resource.data.shopId == getUserData().shopId)
      );
      
      // Users can create their own document during signup, without a shop
      allow create: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.role in ['owner', 'staff'] &&
        request.resource.data.get('shopId', null) == null &&
        request.resource.data.active == true;
      
      // Users can update their own profile (name only)
      // Owner can attach the shop they created; staff can attach a shop only with its invite code
      // Owner can update staff active status
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && (
          changedKeys().hasOnly(['name', 'shopName', 'updatedAt']) ||
          (resource.data.get('shopId', null) == null &&
           resource.data.role == 'owner' &&
           changedKeys().hasOnly(['shopId', 'updatedAt']) &&
           isShopCreator(request.resource.data.shopId)) ||
          (resource.data.get('shopId', null) == null &&
           resource.data.role == 'staff' &&
           changedKeys().hasOnly(['shopId', 'joinCode', 'updatedAt']) &&
           get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinCode)).data.shopId == request.resource.data.shopId)
        )) ||
        (resource.data.role == 'staff' &&
         isActiveOwner(resource.data.shopId) &&
         changedKeys().hasOnly(['active', 'shopName', 'updatedAt'])) ||
        // Owner deleting their shop detaches its staff
        (resource.data.role == 'staff' &&
         isActiveOwner(resource.data.shopId) &&
         changedKeys().hasOnly(['shopId', 'updatedAt']) &&
         request.resource.data.shopId == null)
      );
      
      // Users can delete their own account
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // ============================================
    // INVITE CODES (code -> shopId lookup for joining)
    // ============================================
    match /inviteCodes/{code} {
      // Only direct lookup by exact code; listing all codes is not allowed
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isShopCreator(request.resource.data.shopId);
      allow delete: if isShopCreator(resource.data.shopId);
      // Only the shop/owner name labels can change
      allow update: if isShopCreator(resource.data.shopId) &&
        changedKeys().hasOnly(['shopName', 'ownerName']);
    }
    
    // ============================================
    // SHOPS COLLECTION
    // ============================================
    match /shops/{shopId} {
      // Only the shop's own members (and its creator) can read it
      allow get: if (isAuthenticated() && resource.data.ownerUid == request.auth.uid) ||
        belongsToShop(shopId);
      allow list: if false;
      
      // Only an owner without a shop can create one (they become its owner)
      allow create: if isAuthenticated() && 
        request.resource.data.ownerUid == request.auth.uid &&
        getUserData().role == 'owner' &&
        getUserData().get('shopId', null) == null;
      
      // Only shop owner can update shop settings; ownership cannot be transferred
      allow update: if isActiveOwner(shopId) &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      
      // Only the creating owner can delete the shop (account deletion)
      allow delete: if isActiveOwner(shopId) &&
        resource.data.ownerUid == request.auth.uid;
      
      // ============================================
      // OPENING CASH SUBCOLLECTION
      // ============================================
      match /openingCash/{date} {
        // Anyone in shop can read
        allow read: if canAccessShop(shopId);
        
        // Only owner can create/update/delete
        allow create, update, delete: if isActiveOwner(shopId);
        
        // An opening that follows the previous day's end cash is kept in step
        // by whoever is using the app; a hand-set one only by the owner
        allow create: if canAccessShop(shopId) &&
          request.resource.data.get('carriedFrom', null) is string &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.keys().hasOnly(['amount', 'carriedFrom', 'createdBy', 'createdAt', 'updatedAt']);
        allow update: if canAccessShop(shopId) &&
          resource.data.get('carriedFrom', null) != null &&
          request.resource.data.get('carriedFrom', null) is string &&
          changedKeys().hasOnly(['amount', 'carriedFrom', 'updatedAt']);
      }
      
      // ============================================
      // SALES SUBCOLLECTION
      // ============================================
      match /sales/{saleId} {
        // Anyone in shop can read
        allow read: if canAccessShop(shopId);
        
        // Anyone active in shop can create
        allow create: if canAccessShop(shopId) && 
          request.resource.data.createdBy == request.auth.uid;
        
        // Creator or owner can update
        allow update: if canAccessShop(shopId) && (
          resource.data.createdBy == request.auth.uid || 
          isShopOwner(shopId)
        );
        
        // Creator or owner can delete
        allow delete: if canAccessShop(shopId) && (
          resource.data.createdBy == request.auth.uid || 
          isShopOwner(shopId)
        );
      }
      
      // ============================================
      // EXPENSES SUBCOLLECTION
      // ============================================
      match /expenses/{expenseId} {
        // Anyone in shop can read
        allow read: if canAccessShop(shopId);
        
        // Anyone active in shop can create
        allow create: if canAccessShop(shopId) && 
          request.resource.data.createdBy == request.auth.uid;
        
        // Creator or owner can update
        allow update: if canAccessShop(shopId) && (
          resource.data.createdBy == request.auth.uid || 
          isShopOwner(shopId)
        );
        
        // Creator or owner can delete
        allow delete: if canAccessShop(shopId) && (
          resource.data.createdBy == request.auth.uid || 
          isShopOwner(shopId)
        );
      }
      
      // ============================================
      // EXPENSE CATEGORIES SUBCOLLECTION (Owner Only Write)
      // ============================================
      match /expenseCategories/{categoryId} {
        // Anyone in shop can read (for dropdown)
        allow read: if canAccessShop(shopId);
        
        // Only owner can create/update/delete
        allow create, update, delete: if isActiveOwner(shopId);
        
        // Subcategories
        match /subcategories/{subId} {
          // Anyone in shop can read
          allow read: if canAccessShop(shopId);
          
          // Only owner can create/update/delete
          allow create, update, delete: if isActiveOwner(shopId);
        }
      }
      
      // ============================================
      // DEPOSITS SUBCOLLECTION
      // ============================================
      match /deposits/{depositId} {
        // Anyone in shop can read
        allow read: if canAccessShop(shopId);
        
        // Anyone active in shop can create
        allow create: if canAccessShop(shopId) && 
          request.resource.data.createdBy == request.auth.uid;
        
        // Creator or owner can update
        allow update: if canAccessShop(shopId) && (
          resource.data.createdBy == request.auth.uid || 
          isShopOwner(shopId)
        );
        
        // Creator or owner can delete
        allow delete: if canAccessShop(shopId) && (
          resource.data.createdBy == request.auth.uid || 
          isShopOwner(shopId)
        );
      }
      
      // ============================================
      // RETURNS SUBCOLLECTION
      // ============================================
      match /returns/{returnId} {
        // Anyone in shop can read
        allow read: if canAccessShop(shopId);
        
        // Anyone active in shop can create
        allow create: if canAccessShop(shopId) && 
          request.resource.data.createdBy == request.auth.uid;
        
        // Creator or owner can update
        allow update: if canAccessShop(shopId) && (
          resource.data.createdBy == request.auth.uid || 
          isShopOwner(shopId)
        );
        
        // Creator or owner can delete
        allow delete: if canAccessShop(shopId) && (
          resource.data.createdBy == request.auth.uid || 
          isShopOwner(shopId)
        );
      }
      
      // ============================================
      // CREDIT SALES SUBCOLLECTION
      // ============================================
      match /creditSales/{creditId} {
        // Anyone in shop can read
        allow read: if canAccessShop(shopId);
        
        // Anyone active in shop can create
        allow create: if canAccessShop(shopId) && 
          request.resource.data.createdBy == request.auth.uid;
        
        // Creator or owner can update; anyone in shop can update collectedAmount (recording a collection)
        allow update: if canAccessShop(shopId) && (
          resource.data.createdBy == request.auth.uid || 
          isShopOwner(shopId) ||
          changedKeys().hasOnly(['collectedAmount', 'isPaid', 'updatedAt'])
        );
        
        // Creator or owner can delete
        allow delete: if canAccessShop(shopId) && (
          resource.data.createdBy == request.auth.uid || 
          isShopOwner(shopId)
        );
      }
      
      // ============================================
      // CREDIT COLLECTIONS SUBCOLLECTION
      // ============================================
      match /creditCollections/{collectionId} {
        // Anyone in shop can read
        allow read: if canAccessShop(shopId);
        
        // Anyone active in shop can create
        allow create: if canAccessShop(shopId) && 
          request.resource.data.createdBy == request.auth.uid;
        
        // Creator or owner can update
        allow update: if canAccessShop(shopId) && (
          resource.data.createdBy == request.auth.uid || 
          isShopOwner(shopId)
        );
        
        // Creator or owner can delete
        allow delete: if canAccessShop(shopId) && (
          resource.data.createdBy == request.auth.uid || 
          isShopOwner(shopId)
        );
      }
      
      // ============================================
      // PRODUCTS SUBCOLLECTION
      // ============================================
      match /products/{productId} {
        // Anyone in shop can read
        allow read: if canAccessShop(shopId);
        
        // Anyone active in shop can create
        allow create: if canAccessShop(shopId);
        
        // Anyone in shop can update
        allow update: if canAccessShop(shopId);
        
        // Anyone in shop can delete (soft delete with active flag)
        allow delete: if canAccessShop(shopId);
      }
      
      // ============================================
      // CASH CHECKS (drawer counts during the day)
      // ============================================
      match /cashChecks/{checkId} {
        allow read: if canAccessShop(shopId);
        allow create: if canAccessShop(shopId) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if false;
        allow delete: if isActiveOwner(shopId);
      }
      
      // ============================================
      // MEMBERS (owner and staff of this shop; a copy of their users document)
      // ============================================
      match /members/{memberUid} {
        allow read: if canAccessShop(shopId) || isSuperAdmin();
        
        // A member may write their own entry, but role and active must match their users document
        allow create, update: if isActiveOwner(shopId) || (
          request.auth.uid == memberUid &&
          belongsToShop(shopId) &&
          request.resource.data.uid == memberUid &&
          request.resource.data.role == getUserData().role &&
          request.resource.data.active == getUserData().active
        );
        
        allow delete: if isActiveOwner(shopId) ||
          (isAuthenticated() && request.auth.uid == memberUid);
      }
      
      // ============================================
      // STOCK ENTRIES (goods received / stock counts)
      // ============================================
      match /stockEntries/{entryId} {
        allow read: if canAccessShop(shopId);
        allow create: if canAccessShop(shopId) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isActiveOwner(shopId);
      }
    }
  }
}
